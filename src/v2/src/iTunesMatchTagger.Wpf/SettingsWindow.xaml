<Window x:Class="iTunesMatchTagger.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Background="{DynamicResource Bg}"
        Width="600" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0">
      <TabItem Header="Sources">
        <StackPanel Margin="4,12,4,4">
          <TextBlock Foreground="{DynamicResource Subtle}" FontSize="12" TextWrapping="Wrap"
                     Text="Apple (iTunes Search) is always tried first. The enabled sources act as fallback when Apple misses anything." />
          <ItemsControl x:Name="SourcesList" Margin="0,10,0,0" IsTabStop="False"
                        ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Panel}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsChecked}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0"
                               Text="{Binding Info.DisplayName, Mode=OneWay}" />
                    <TextBox Grid.Column="2"
                             Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasTokenColumn, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Foreground="{DynamicResource Subtle}" FontSize="11.5"
                     Text="Discogs requires a personal access token (discogs.com > Settings > Developers > Personal access tokens)." />
        </StackPanel>
      </TabItem>

      <TabItem Header="Options">
        <StackPanel Margin="4,14,4,4">
          <CheckBox Content="Always query all enabled sources, even when Apple finds the track"
                    IsChecked="{Binding AlwaysQueryAll}" Margin="2,4" />
          <CheckBox Content="Include lyrics from LRCLib (synced LRC when available, else plain text)"
                    IsChecked="{Binding IncludeLyrics}" Margin="2,4" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Storefronts">
        <StackPanel Margin="4,14,4,4">
          <TextBlock Foreground="{DynamicResource Subtle}" FontSize="12" TextWrapping="Wrap"
                     Text="iTunes storefronts tried in order for Apple lookups. When a track ID is not found in any of them, all remaining storefronts are swept automatically." />
          <TextBlock Foreground="{DynamicResource Subtle}" FontSize="12" Margin="0,10,0,2"
                     Text="Storefront codes (comma separated, e.g. CO, US, JP)" />
          <TextBox Text="{Binding CountriesText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Fields">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DataGrid Grid.Row="0" ItemsSource="{Binding Fields}" RowHeight="30">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Update" Binding="{Binding Update, UpdateSourceTrigger=PropertyChanged}" Width="60" />
              <DataGridTextColumn Header="Field" Binding="{Binding FieldName, Mode=OneWay}" Width="130" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="Overwrite" Binding="{Binding Overwrite, UpdateSourceTrigger=PropertyChanged}" Width="76" />
              <DataGridTextColumn Header="Value" Binding="{Binding OverwriteValue, UpdateSourceTrigger=PropertyChanged}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Foreground="{DynamicResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Update marks the fields written by the Update step when the track's own mask (Use) allows it. Overwrite replaces the candidate value with a fixed value for every track." />
        </Grid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Width="90" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </Grid>
</Window>

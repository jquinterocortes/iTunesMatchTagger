<Window x:Class="iTunesMatchTagger.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iTunes Match Tagger v3"
        Background="{DynamicResource Bg}"
        Width="1380" Height="900" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="StatusDotTemplate">
      <Ellipse Width="9" Height="9" VerticalAlignment="Center">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Subtle}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                <Setter Property="Fill" Value="{DynamicResource Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
                <Setter Property="Fill" Value="{DynamicResource Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusSeverity}" Value="Error">
                <Setter Property="Fill" Value="{DynamicResource Danger}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
    </DataTemplate>

    <!-- cell template used by the Current + per-source comparison columns -->
    <DataTemplate x:Key="SourceCellTemplate">
      <Grid>
        <Image Height="96" Stretch="Uniform" HorizontalAlignment="Left" Margin="1"
               Source="{Binding Image, Mode=OneWay}"
               Visibility="{Binding Image, Converter={StaticResource NullToCollapsed}}" />
        <TextBlock Text="{Binding Text, Mode=OneWay}"
                   Visibility="{Binding Image, Converter={StaticResource NullToVisible}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
    <!-- hides the Use checkbox on display-only rows (Artwork Preview) -->
    <Style x:Key="UseCellCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPreview}" Value="True">
          <Setter Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- toolbar -->
      <RowDefinition Height="*" />      <!-- workspace -->
      <RowDefinition Height="Auto" />   <!-- status line -->
      <RowDefinition Height="Auto" />   <!-- log drawer -->
    </Grid.RowDefinitions>

    <!-- ================= Toolbar ================= -->
    <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,7,12,7" LastChildFill="False">
        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Style="{StaticResource IconOnlyButton}"
                Content="&#x2699;&#xFE0E;" Command="{Binding OpenSettingsCommand}"
                ToolTip="Settings: sources, storefronts, lyrics, fields" />
        <Button DockPanel.Dock="Right" Margin="4,0,0,0"
                Content="Load folder&#x2026;" Command="{Binding LoadFolderCommand}" />
        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Command="{Binding CancelCommand}" ToolTip="Cancel the running operation">
          <TextBlock Foreground="{DynamicResource Danger}" Text="&#x2715;" />
        </Button>

        <Button DockPanel.Dock="Left" Margin="0,0,4,0" Content="1. Get tracks" Command="{Binding GetTracksCommand}" />
        <Button DockPanel.Dock="Left" Margin="4,0" Content="2. Lookup" Command="{Binding LookupCommand}" />
        <Button DockPanel.Dock="Left" Margin="4,0" Style="{StaticResource PrimaryButton}" Content="3. Update" Command="{Binding UpdateCommand}" />
      </DockPanel>
    </Border>

    <!-- ================= Workspace ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="7*" MinWidth="420" />
      </Grid.ColumnDefinitions>

      <!--Tracks-->
      <Grid Grid.Column="0" Margin="12,8,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource Subtle}"
                     Text="{Binding TrackCountText}" />
          <ComboBox Grid.Column="1" x:Name="FilterBox" Width="160" SelectionChanged="FilterBox_SelectionChanged"
                    ToolTip="Filter the list by status">
            <ComboBoxItem Content="All tracks" IsSelected="True" />
            <ComboBoxItem Content="Pending lookup" />
            <ComboBoxItem Content="Matched" />
            <ComboBoxItem Content="Errors only" />
          </ComboBox>
        </Grid>
        <ListBox Grid.Row="1" x:Name="TrackList" ItemsSource="{Binding Rows}"
                 SelectionChanged="TrackList_SelectionChanged"
                 VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,4" Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="17" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding SkipUpdate}" VerticalAlignment="Center"
                          ToolTip="Excluded from the Update step" />
                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="4" Background="{DynamicResource PanelAlt}">
                  <Image Source="{Binding Thumbnail, Mode=OneWay}" Margin="2" />
                </Border>
                <ContentPresenter Grid.Column="2" Margin="5,0,5,0" VerticalAlignment="Center"
                                  Content="{Binding}" ContentTemplate="{StaticResource StatusDotTemplate}" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="{Binding Caption, Mode=OneWay}" Style="{StaticResource FieldText}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Style="{StaticResource StatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Subtle}"
                           Text="{Binding SourceBadge, Mode=OneWay}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="Transparent" ShowsPreview="False" />

      <!--Detail-->
      <Grid Grid.Column="2" Margin="8,8,12,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />  <!-- write-from picker -->
          <RowDefinition Height="*"    />  <!-- comparison grid (artwork is a row inside it) -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Write from:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Subtle}" />
          <ComboBox Grid.Column="1" x:Name="WriteFromPicker" Width="160" Margin="0,0,12,0"
                    SelectionChanged="WriteFromPicker_SelectionChanged" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource Subtle}" FontSize="12"
                     Text="Pick a candidate per source in the column headers; this chooses which source is written." />
        </Grid>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DataGrid x:Name="DetailGrid"
                    DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
                    ItemsSource="{Binding DetailRows, Mode=OneWay}">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                     ElementStyle="{StaticResource UseCellCheckBoxStyle}" />
            <DataGridTextColumn Header="Field" Binding="{Binding FieldName, Mode=OneWay}" Width="120" IsReadOnly="True" />
            <DataGridTemplateColumn Header="Current" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding CurrentCell, Mode=OneWay}" ContentTemplate="{StaticResource SourceCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Apple" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding SourceCells[itunes], Mode=OneWay}" ContentTemplate="{StaticResource SourceCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="MusicBrainz" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding SourceCells[musicbrainz], Mode=OneWay}" ContentTemplate="{StaticResource SourceCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Discogs" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding SourceCells[discogs], Mode=OneWay}" ContentTemplate="{StaticResource SourceCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Deezer" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding SourceCells[deezer], Mode=OneWay}" ContentTemplate="{StaticResource SourceCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Lyrics preview (no write; what Update would store) -->
        <Border Grid.Row="1" Margin="0,8,0,0" Background="{DynamicResource Panel}" CornerRadius="6" Padding="10,8">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Content="&#x21bb;"
                      Click="RefreshLyrics_Click" ToolTip="Search the lyrics again on LRCLib" />
              <CheckBox DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                        Content="Write on update" ToolTip="Write these lyrics to the file during the Update step (per track)"
                        IsChecked="{Binding SelectedRow.LyricsWriteEnabled}" />
              <TextBlock Text="Lyrics preview" Foreground="{DynamicResource Subtle}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                         Foreground="{DynamicResource Subtle}" Text="{Binding LyricsStatus, Mode=OneWay}" />
            </DockPanel>
            <TextBox Height="110" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     Margin="0,6,0,0" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding LyricsPreview, Mode=OneWay}" />
          </StackPanel>
        </Border>
      </Grid>
      </Grid>
    </Grid>

    <!-- ================= Status line ================= -->
    <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
      <Grid Margin="12,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Click="ToggleLog_Click" Style="{StaticResource IconOnlyButton}"
                x:Name="ToggleLogButton" Content="&#x25B8; Log" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Subtle}" Text="{Binding StatusText, Mode=OneWay}" />
        <ProgressBar Grid.Column="2" Width="180" Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                     Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ================= Log drawer ================= -->
    <Border x:Name="LogDrawer" Grid.Row="3" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            Visibility="Collapsed" Height="190">
      <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Standard">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="2,1">
              <TextBlock Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource Subtle}" FontFamily="Consolas" FontSize="12" Margin="0,0,10,0" />
              <TextBlock Text="{Binding Message}" Style="{StaticResource LogLineText}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <Authors>Johann Quintero</Authors>
    <Product>iTunesMatchTagger</Product>
    <Description>Core library for repairing iTunes Match track metadata: iTunes Search API client, embedded Track-ID parsing, and tag field mapping for the iTunes COM model and audio files (TagLib#).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
